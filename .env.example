# TESTNET ONLY. Never commit the real .env.
# Everything here is OPTIONAL. With no .env the game runs exactly the same; it just doesn't settle to a chain.
# With these set, `npm run server` streams the running game (goods and coins) to the testnet in the background. CHAIN_SYNC=0 turns that off.
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
# Account that deploys/owns the items contract and acts as the settler (relayer).
NEAR_ACCOUNT_ID=
NEAR_PRIVATE_KEY=ed25519:...
# Defaults to NEAR_ACCOUNT_ID.
CONTRACT_ID=
# Namespace for sim accounts, e.g. mira.<parent>. Defaults to CONTRACT_ID.
ACCOUNT_PARENT=
# Player-key encryption + session signing. Generate each with: openssl rand -hex 32
MASTER_KEY=
SESSION_SECRET=

# --- Hosting (all optional; see README "Host it") ---
# The public address of your deployment. Login links point here. Use https so the session cookie is marked Secure.
PUBLIC_URL=
# Real login emails through Resend (https://resend.com). Without a key, links are printed in the server log.
RESEND_API_KEY=
MAIL_FROM=Nims <onboarding@resend.dev>
# Where accounts, wallets and chain progress are stored. Mount a persistent volume here (the Dockerfile uses /data).
DATA_DIR=

# --- Merchant voice (optional) ---
# NEAR AI Cloud writes each merchant's price explanation in their own voice. Prices never depend on it;
# without a key the game shows the plain explanation. Create a key at https://cloud.near.ai
NEAR_AI_API_KEY=sk-78db739152af40c890636f139cf3ca8f
# Optional: pick another model (default google/gemini-3.1-flash-lite; "thinking" models need extra settings and are too slow for a hover) or point at a different OpenAI-compatible base URL.
NEAR_AI_MODEL=
NEAR_AI_BASE_URL=
