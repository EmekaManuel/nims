{
  "name": "nims-video",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Nims out/nims-demo.mp4",
    "render:silent": "remotion render src/index.ts NimsSilent out/nims-demo-silent.mp4",
    "session": "cd .. && npx tsx --env-file=.env video/scripts/play-session.ts",
    "ffrun": "cd .. && npx tsx video/scripts/make-ffrun.ts",
    "measure": "node scripts/measure-targets.mjs",
    "render:launch": "remotion render src/index.ts NimsDemo out/nims-demo-launch.mp4 --codec=h264 --x264-preset=veryfast --crf=18",
    "vo": "node --env-file=../.env scripts/vo.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.290",
    "@remotion/cli": "^4.0.290",
    "@remotion/google-fonts": "^4.0.290",
    "@remotion/renderer": "^4.0.290",
    "@types/react": "^18.3.31",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.290"
  },
  "devDependencies": {
    "playwright-core": "^1.49.1",
    "typescript": "^5.5.4"
  }
}