{
  "name": "nims-video",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Nims out/nims-demo.mp4",
    "render:silent": "remotion render src/index.ts NimsSilent out/nims-demo-silent.mp4",
    "session": "cd .. && npx tsx --env-file=.env video/scripts/play-session.ts",
    "measure": "node scripts/measure-targets.mjs"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.290",
    "@remotion/google-fonts": "^4.0.290",
    "@types/react": "^18.3.31",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.290",
    "@remotion/bundler": "^4.0.290",
    "@remotion/renderer": "^4.0.290"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
